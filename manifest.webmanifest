{
  "name": "FlockOff — ALPR Proximity Map",
  "short_name": "FlockOff",
  "description": "A map of nearby ALPR (license-plate reader) cameras with real-time proximity alerts, from crowdsourced OpenStreetMap data. Passive, offline-first, privacy-respecting.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0d1117",
  "theme_color": "#0d1117",
  "categories": ["navigation", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
